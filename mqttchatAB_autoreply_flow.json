    "info": "",
    "x": 240,
    "y": 40,
    "wires": []
  },
  {
    "id": "a_inject",
    "type": "inject",
    "z": "tab_chat",
    "name": "BAM DE CHAY (A gui, B tu tra loi)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "Xin chao, thu MQTT!",
    "payloadType": "str",
    "x": 150,
    "y": 250,
    "wires": [
      [
        "a_build"
      ]
    ]
  },
  {
    "id": "a_build",
    "type": "function",
    "z": "tab_chat",
    "name": "A dong goi tin",
    "func": "const text = msg.payload;\n\nmsg.payload = {\n    id: Date.now(),\n    from: \"A\",\n    text: text,\n    sentAt: new Date().toISOString()\n};\n\nmsg.topic = \"chat/A\";\nmsg.qos = 1;\nmsg.retain = false;\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
    "wires": [
      [
        "a_out",
        "a_dbg_sent"
      ]
    ]
  },
  {
    "id": "a_out",
    "type": "mqtt out",
    "z": "tab_chat",
    "name": "A publish chat/A",
    "topic": "chat/A",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker_a",
    "x": 600,
    "y": 80,
    "wires": []
  },
  {
    "id": "a_dbg_sent",
    "type": "debug",
    "z": "tab_chat",
    "name": "[A] Da gui",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
