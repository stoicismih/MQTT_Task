    "x": 590,
    "y": 130,
    "wires": []
  },
  {
    "id": "a_in",
    "type": "mqtt in",
    "z": "tab_chat",
    "name": "A subscribe chat/B",
    "topic": "chat/B",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker_a",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 200,
    "wires": [
      [
        "a_handle"
      ]
    ]
  },
  {
    "id": "a_handle",
    "type": "function",
    "z": "tab_chat",
    "name": "A xu ly tin nhan",
    "func": "const p = msg.payload;\n\nif (typeof p !== \"object\" || p === null) {\n    node.warn(\"Tin nhan khong phai JSON: \" + p);\n    return null;\n}\n\nmsg.payload = {\n    topic: msg.topic,\n    from: p.from,\n    text: p.text,\n    latencyMs: Date.now() - new Date(p.sentAt).getTime(),\n    receivedAt: new Date().toISOString()\n};\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"nhan tu \" + p.from + \": \" + p.text });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 200,
    "wires": [
      [
        "a_dbg_recv"
      ]
    ]
  },
